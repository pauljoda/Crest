        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authentifiez-vous avant que Crest ne déverrouille les espaces privés ou n’affiche, ne copie ou n’exporte les mots de passe enregistrés."
          }
        }
      }
    },
