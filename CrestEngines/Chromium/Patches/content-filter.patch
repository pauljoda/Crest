 void ChromeContentRendererClient::RunScriptsAtDocumentStart(
     content::RenderFrame* render_frame) {
+#if BUILDFLAG(IS_MAC)
+  // Crest's scriptlets run before the page's own scripts, in its own world.
+  if (auto* scriptlets = js_injection::JsCommunication::Get(render_frame)) {
+    class FrameWatch final : public content::RenderFrameObserver {
+     public:
+      explicit FrameWatch(content::RenderFrame* frame)
+          : content::RenderFrameObserver(frame) {}
+      void OnDestruct() override { gone_ = true; }
+      bool gone() const { return gone_; }
+
+     private:
+      bool gone_ = false;
+    } watch(render_frame);
+    scriptlets->RunScripts(
+        js_injection::mojom::DocumentInjectionTime::kDocumentStart);
+    if (watch.gone()) {
+      return;
+    }
+  }
+#endif
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   extensions::ExtensionsRendererClient::Get()->RunScriptsAtDocumentStart(
       render_frame);
