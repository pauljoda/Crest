       nullptr;
   std::unique_ptr<ui::RecyclableCompositorMac> recyclable_compositor_;
+  // Crest: a navigation that swaps views hides the old view before the new
+  // one is shown. The old view keeps its compositor, which still shows the
+  // old page, with that frame until the task ends, and the new view draws
+  // with it, so no blank frame comes between the two pages.
+  struct HandedCompositor {
+    std::unique_ptr<ui::RecyclableCompositorMac> compositor;
+    gfx::CALayerParams last_frame;
+  };
+  std::optional<HandedCompositor> retired_compositor_;
+  std::optional<HandedCompositor> adopted_compositor_;
+  // The last frame of the adopted compositor this view draws with. Its frames
+  // go on in the same layer context, which the GPU process doesn't report
+  // again, so its widget has no frame of its own until the context changes.
+  std::optional<gfx::CALayerParams> continued_frame_;
+  void ReleaseUnusedCompositors();
 
   std::unique_ptr<DelegatedFrameHost> delegated_frame_host_;
   std::unique_ptr<ui::LayerSurface> root_layer_;
