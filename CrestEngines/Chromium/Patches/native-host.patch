+
+// A profile directory does not namespace OSCrypt's macOS keychain item.
+// Keep packaged Crest experiments separate from Chromium, Chrome, and Crest's
+// credential vault. Normal Chromium builds retain their upstream names.
+std::string CrestKeychainName(bool service) {
+  const auto bundle = base::apple::BaseBundleID();
+  if (bundle == "com.pauldavis.crest.control-plane.chromium") {
+    return service ? "Crest Chromium Experiment Safe Storage"
+                   : "com.pauldavis.crest.control-plane.chromium";
+  }
+  if (bundle == "com.pauldavis.crest.chromium-baseline") {
+    return service ? "Crest Chromium Baseline Safe Storage"
+                   : "com.pauldavis.crest.chromium-baseline";
+  }
+  return service ? kDefaultServiceName : kDefaultAccountName;
+}
 
