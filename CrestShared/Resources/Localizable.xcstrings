      }
    },
    "Crest can’t reach %@ without a network connection." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Crest الوصول إلى %@ من دون اتصال بالشبكة."
          }
        }
      }
    },
    "Crest checks while the browser is running. A cached copy stays active if a source is temporarily unavailable." : {
      "extractionState" : "stale",
