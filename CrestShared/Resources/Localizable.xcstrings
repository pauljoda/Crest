          }
        }
      }
    },
    "The credential belongs to the embedded %@ frame, not %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتمي بيانات الاعتماد إلى إطار %1$@ المضمّن، وليس إلى %2$@."
