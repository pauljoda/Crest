    },
    "This device only" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil uniquement"
          }
        }
      }
    },
    "This download was blocked because it came over an insecure connection." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléchargement a été bloqué car il utilisait une connexion non sécurisée."
          }
        }
      }
    },
    "This download was blocked because it could harm your computer." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléchargement a été bloqué car il pourrait endommager votre ordinateur."
          }
        }
      }
    },
    "This download was blocked by a safety or organization policy." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléchargement a été bloqué par une règle de sécurité ou de l’organisation."
          }
        }
      }
    },
    "This extension will be installed in %@. Select any additional Spaces below." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette extension sera installée dans %@. Sélectionnez les espaces supplémentaires ci-dessous."
          }
        }
      }
    },
    "This file does not contain any HTTP or HTTPS bookmarks Crest can import." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا الملف على أي إشارات مرجعية HTTP أو HTTPS يمكن لـ Crest استيرادها."
          }
        },
