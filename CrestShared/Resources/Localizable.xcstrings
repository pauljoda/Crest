    "Created %lld Spaces and added %lld tabs." : {
      "comment" : "Completion summary after manual setup. The first count is new Spaces; the second is added tabs.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إنشاء %#@spaces@ و%#@tabs@."
          },
          "substitutions" : {
            "spaces" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%lld مساحات"
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%lld مساحة"
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "مساحة واحدة"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%lld مساحة"
                    }
