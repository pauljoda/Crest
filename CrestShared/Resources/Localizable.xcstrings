      }
    },
    "This browsing session is too large to sync." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session de navigation est trop volumineuse pour être synchronisée."
          }
        }
      }
    },
    "This build cannot request browser-wide passkey access until Apple approves Crest’s managed capability." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تستطيع هذه النسخة طلب وصول مفاتيح المرور على مستوى المتصفح حتى تعتمد Apple القدرة المُدارة لـ Crest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version ne peut pas demander l’accès aux clés d’accès pour l’ensemble du navigateur tant qu’Apple n’a pas approuvé cette capacité pour Crest."
          }
        }
      }
    },
    "This build of Crest does not include permission to request browser passkey access." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de Crest ne dispose pas de l’autorisation nécessaire pour demander l’accès aux clés d’accès du navigateur."
          }
        }
      }
    },
    "This Chromium session is profile-encrypted and cannot be safely imported outside its source browser." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جلسة Chromium هذه مشفرة بالملف الشخصي ولا يمكن استيرادها بأمان خارج متصفحها المصدر."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session Chromium est chiffrée par profil et ne peut pas être importée en toute sécurité hors de son navigateur d’origine."
          }
        }
      }
    },
    "This credential belongs to the embedded %@ frame, not %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتمي بيانات الاعتماد هذه إلى إطار %1$@ المضمّن، وليس إلى %2$@."
          }
