        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحقق Crest أثناء تشغيل المتصفح. تظل نسخة مخزنة مؤقتًا نشطة إذا كان أحد المصادر غير متاح مؤقتًا."
          }
        }
      }
    },
    "Crest could not read %@ data there. Try Allow Access again, or choose the %@ data folder if it moved." : {
      "comment" : "Browser-import error. Both variables are the source browser name.",
      "localizations" : {
        "ar" : {
