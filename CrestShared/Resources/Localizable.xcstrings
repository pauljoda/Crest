    "Crest Passwords" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمات مرور Crest"
          }
        }
      }
    },
    "Crest Passwords remain private to this Space. System Passwords and passkeys are provider-managed and may appear in any Space for the matching site." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظل كلمات مرور Crest خاصة بهذه المساحة. تُدار «كلمات السر» ومفاتيح المرور بواسطة موفري النظام وقد تظهر في أي مساحة للموقع المطابق."
          }
        }
      }
    },
    "Crest Passwords stay in this Space. They never enter another Space’s suggestions or records." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى كلمات مرور Crest في هذه المساحة. ولا تدخل مطلقًا في اقتراحات أو سجلات مساحة أخرى."
