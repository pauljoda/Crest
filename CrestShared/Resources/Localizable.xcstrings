          }
        }
      }
    },
    "The credential belongs to the embedded %@ frame, not %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتمي بيانات الاعتماد إلى إطار %1$@ المضمّن، وليس إلى %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The credential belongs to the embedded %1$@ frame, not %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identifiant appartient au cadre intégré %1$@, et non à %2$@."
          }
        }
      }
    },
    "The credential belongs to the embedded %arg frame, not %arg." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتمي بيانات الاعتماد هذه إلى إطار %1$arg المضمّن، وليس إلى %2$arg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The credential belongs to the embedded %1$arg frame, not %2$arg."
          }
        },
