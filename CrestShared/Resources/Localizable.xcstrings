    },
    "A calmer browser, shaped around the Spaces that matter to you." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متصفح أكثر هدوءًا، مصمم حول المساحات التي تهمك."
          }
        }
      }
    },
    "A crest gives this Space its own identity. Start with a preset or make your own." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنح الشعار هذه المساحة هويتها الخاصة. ابدأ بتصميم جاهز أو صمّم شعارك بنفسك."
          }
