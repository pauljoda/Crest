          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet identifiant appartient au cadre intégré %1$@, et non à %2$@."
          }
        }
      }
    },
    "This Crest browser-data version (%lld) is not supported." : {
      "localizations" : {
