<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <ProjectReference Include="../../src/CrestCore/CrestCore.csproj" />
    <ProjectReference Include="../../src/CrestCore.Native/CrestCore.Native.csproj" />
    <ProjectReference Include="../../tools/CrestCore.Generator/CrestCore.Generator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Session/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Storage/Fixtures/*.sqlite" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Portability/Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Without Native AOT the content filter is loaded as a dynamic library from
       beside the tests: linked from the prebuilt static library on a Mac, and
       compiled from source elsewhere. -->
  <Target Name="CrestContentFilterTestLibrary" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <CrestContentFilterPathFile>$(IntermediateOutputPath)content-filter.path</CrestContentFilterPathFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)../../../Scripts/control-plane/fetch-content-filter.py&quot; --runtime host &gt; &quot;$(CrestContentFilterPathFile)&quot;"
        IgnoreStandardErrorWarningFormat="true" />
    <ReadLinesFromFile File="$(CrestContentFilterPathFile)">
      <Output TaskParameter="Lines" PropertyName="CrestContentFilterLibraryPath" />
    </ReadLinesFromFile>
    <ItemGroup>
      <None Include="$(CrestContentFilterLibraryPath)" Link="$([System.IO.Path]::GetFileName('$(CrestContentFilterLibraryPath)'))"
          CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
