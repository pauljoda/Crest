<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Deterministic>true</Deterministic>
    <!-- The Python the build's scripts run under. Windows has no python3; its
         launcher picks the newest installed Python 3. -->
    <CrestPython Condition="'$(CrestPython)' == '' and '$(OS)' == 'Windows_NT'">py -3</CrestPython>
    <CrestPython Condition="'$(CrestPython)' == ''">python3</CrestPython>
  </PropertyGroup>
</Project>
