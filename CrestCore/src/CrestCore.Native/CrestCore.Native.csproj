<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The apps' deployment target (project.yml), which the content filter is built for too. -->
    <AppleMinOSVersion>26.1</AppleMinOSVersion>
    <CrestRuntimeFamily Condition="$(RuntimeIdentifier.StartsWith('osx-')) or $(RuntimeIdentifier.StartsWith('ios'))">apple</CrestRuntimeFamily>
    <CrestRuntimeFamily Condition="$(RuntimeIdentifier.StartsWith('win-'))">windows</CrestRuntimeFamily>
    <CrestRuntimeFamily Condition="$(RuntimeIdentifier.StartsWith('linux-'))">linux</CrestRuntimeFamily>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CrestCore/CrestCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The session file uses the system SQLite: the library every Apple
         platform and Linux distribution ships, and on Windows the copy the OS
         ships as winsqlite3.dll, whose import library is in the Windows SDK.
         The managed code names it libsqlite3 everywhere. -->
    <DirectPInvoke Include="libsqlite3" />
    <NativeLibrary Include="-lsqlite3" Condition="'$(CrestRuntimeFamily)' == 'apple' or '$(CrestRuntimeFamily)' == 'linux'" />
    <NativeLibrary Include="winsqlite3.lib" Condition="'$(CrestRuntimeFamily)' == 'windows'" />
    <!-- The content filter is linked in statically: the prebuilt library the
         lock in CrestCore/native/ContentFilter names, for the runtime published. -->
    <DirectPInvoke Include="crest_content_filter" />
  </ItemGroup>
  <Target Name="CrestContentFilterLibrary" BeforeTargets="SetupOSSpecificProps" Condition="'$(CrestRuntimeFamily)' != ''">
    <PropertyGroup>
      <CrestContentFilterPathFile>$(IntermediateOutputPath)content-filter.path</CrestContentFilterPathFile>
    </PropertyGroup>
    <Exec Command="$(CrestPython) &quot;$(MSBuildThisFileDirectory)../../../Scripts/control-plane/fetch-content-filter.py&quot; --runtime $(RuntimeIdentifier) &gt; &quot;$(CrestContentFilterPathFile)&quot;"
        IgnoreStandardErrorWarningFormat="true" />
    <ReadLinesFromFile File="$(CrestContentFilterPathFile)">
      <Output TaskParameter="Lines" PropertyName="CrestContentFilterLibraryPath" />
    </ReadLinesFromFile>
    <ItemGroup>
      <NativeLibrary Include="$(CrestContentFilterLibraryPath)" />
      <!-- An engine that checks each request itself calls the slot check directly,
           without the core's managed code. -->
      <CrestContentFilterExport Include="crest_content_filter_slot_check;crest_content_filter_slot_check_redirect;crest_content_filter_buffer_free" />
      <LinkerArg Include="@(CrestContentFilterExport->'-Wl,-exported_symbol,_%(Identity)')" Condition="'$(CrestRuntimeFamily)' == 'apple'" />
      <LinkerArg Include="@(CrestContentFilterExport->'/EXPORT:%(Identity)')" Condition="'$(CrestRuntimeFamily)' == 'windows'" />
      <LinkerArg Include="@(CrestContentFilterExport->'-Wl,--export-dynamic-symbol=%(Identity)')" Condition="'$(CrestRuntimeFamily)' == 'linux'" />
      <!-- The Rust standard library's Windows imports, which a static Rust
           library leaves to the final link. -->
      <NativeLibrary Include="ws2_32.lib;userenv.lib;ntdll.lib;bcrypt.lib;advapi32.lib" Condition="'$(CrestRuntimeFamily)' == 'windows'" />
    </ItemGroup>
  </Target>
</Project>
