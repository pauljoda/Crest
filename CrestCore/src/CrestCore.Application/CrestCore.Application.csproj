<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- SQLite is called through LibraryImport, whose generated stubs are unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Storage tests read and fault the session file through the core's own connection. -->
    <InternalsVisibleTo Include="CrestCore.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CrestCore.Domain/CrestCore.Domain.csproj" />
    <ProjectReference Include="../CrestCore.Contracts/CrestCore.Contracts.csproj" />
  </ItemGroup>
</Project>
